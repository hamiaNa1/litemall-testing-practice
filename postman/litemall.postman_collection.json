{
  "info": {
    "name": "litemall 真实订单业务流",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 匿名商品查询",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/wx/goods/list?page=1&limit=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('列表有商品',()=>pm.expect(pm.response.json().data.list.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 无Token购物车",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/wx/cart/index"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 501',()=>pm.expect(pm.response.json().errno).to.eql(501));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 缺失登录参数",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/wx/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 401',()=>pm.expect(pm.response.json().errno).to.eql(401));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 账号密码登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/wx/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('Token存在',()=>pm.expect(pm.response.json().data.token).to.be.a('string'));",
              "if(pm.response.json().errno===0) pm.environment.set('token',pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 商品详情及规格",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/wx/goods/detail?id={{goods_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('商品ID匹配',()=>pm.expect(pm.response.json().data.info.id).to.eql(Number(pm.environment.get('goods_id'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 数量零被拒绝",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/cart/add",
        "body": {
          "mode": "raw",
          "raw": "{\"goodsId\": \"{{goods_id}}\", \"productId\": \"{{product_id}}\", \"number\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 401',()=>pm.expect(pm.response.json().errno).to.eql(401));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 加入购物车",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/cart/fastadd",
        "body": {
          "mode": "raw",
          "raw": "{\"goodsId\": \"{{goods_id}}\", \"productId\": \"{{product_id}}\", \"number\": 2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('购物车ID',()=>pm.expect(pm.response.json().data).to.be.above(0));",
              "if(pm.response.json().errno===0) pm.environment.set('cart_id',pm.response.json().data);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 购物车数量",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/cart/index"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('购买数量2',()=>pm.expect(pm.response.json().data.cartTotal.goodsCount).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 收货地址",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/address/save",
        "body": {
          "mode": "raw",
          "raw": "{\"id\": 0, \"name\": \"QA 测试\", \"tel\": \"13800138000\", \"province\": \"广东省\", \"city\": \"深圳市\", \"county\": \"南山区\", \"areaCode\": \"440305\", \"addressDetail\": \"Postman测试不发货\", \"isDefault\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "if(pm.response.json().errno===0) pm.environment.set('address_id',pm.response.json().data);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 提交待付款订单",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/order/submit",
        "body": {
          "mode": "raw",
          "raw": "{\"cartId\": \"{{cart_id}}\", \"addressId\": \"{{address_id}}\", \"couponId\": 0, \"userCouponId\": 0, \"grouponRulesId\": 0, \"grouponLinkId\": 0, \"message\": \"Postman测试\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('订单ID',()=>pm.expect(pm.response.json().data.orderId).to.be.above(0));",
              "if(pm.response.json().errno===0) pm.environment.set('order_id',pm.response.json().data.orderId);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 查询订单详情",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/order/detail?orderId={{order_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('订单关联',()=>pm.expect(pm.response.json().data.orderInfo.id).to.eql(Number(pm.environment.get('order_id'))));",
              "pm.test('待付款可取消',()=>pm.expect(pm.response.json().data.orderInfo.handleOption.cancel).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 提交后购物车清空",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/cart/index"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('购物车清空',()=>pm.expect(pm.response.json().data.cartList).to.have.length(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 取消订单",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/order/cancel",
        "body": {
          "mode": "raw",
          "raw": "{\"orderId\": \"{{order_id}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 查询已取消订单",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{base_url}}/wx/order/detail?orderId={{order_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务码 0',()=>pm.expect(pm.response.json().errno).to.eql(0));",
              "pm.test('响应结构',()=>pm.expect(pm.response.json().errmsg).to.be.a('string'));",
              "pm.test('取消状态',()=>pm.expect(pm.response.json().data.orderInfo.orderStatusText).to.eql('已取消'));"
            ]
          }
        }
      ]
    }
  ]
}